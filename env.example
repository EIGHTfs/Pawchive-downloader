# Pawchive-downloader 环境变量模板（复制为 .env 或直接 export；全部可选，有默认值）

# ---------- API ----------
# API 基地址（Pawchive 后端）
PAWCHIVE_API_BASE=https://pawchive.pw/api/v1
# 文件下载 host（原图）
PAWCHIVE_FILES_BASE=https://file.pawchive.pw
# 文件路径前缀（服务器 path 前拼的 /data）
PAWCHIVE_FILES_PREFIX=/data
# 原图 404 时缩略图回退 base（img host /thumbnail 前缀；成功下载文件名加 _thumb 标记）
PAWCHIVE_THUMB_BASE=https://img.pawchive.pw/thumbnail
# 断点续传临时文件后缀
PAWCHIVE_TEMP_SUFFIX=.tmp

# ---------- 命名模板 ----------
# 创作者目录名模板（{creator_name} {creator_id} {service}；跨渠道同名自动合并目录）
PAWCHIVE_CREATOR_DIR_FORMAT={creator_name}
# 帖子目录名模板（{title} {post_id} {service} {creator_id} {published} {added}）
PAWCHIVE_POST_DIR_FORMAT={title}
# 文件名模板（{} = 原文件名，默认不启用 = 用服务端真实文件名）
PAWCHIVE_FILENAME_FORMAT={}
# 索引 html 文件名（帖子级 + 创作者级共用）
PAWCHIVE_INDEX_FILENAME=pawchive-index.html
# 创作者目录大小写冲突时的前缀模板（{service}，如 (patreon) Akt）
PAWCHIVE_CREATOR_PREFIX_FORMAT=({service})
# 同帖内同名不同内容文件的后缀模板（{size}=文件大小字节，无大小退序号；放扩展名前）
PAWCHIVE_FILENAME_SUFFIX_FORMAT=_{size}

# ---------- 下载参数（反爬安全默认：TPS ≤1 req/s、并发 ≤5 活动下载） ----------
# 下载/探测请求 User-Agent（file host 反爬要求「可识别 UA」）
PAWCHIVE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
# 每秒新建连接上限（file host 明示 ≤1 req/s，超速返回 376B 占位）
PAWCHIVE_TPS=1
# 并行下载并发数（worker 池式并行；file host 最多 5 个活动下载，5 = 上限）
PAWCHIVE_CONCURRENCY=5
# 列表翻页间隔毫秒（防页间连发触发 API 限流）
PAWCHIVE_PAGE_INTERVAL_MS=1000
# 下载重试次数（仅网络错误重试；HTTP 4xx/5xx 确定性失败不重试）
PAWCHIVE_RETRY_TIMES=10
# 下载重试间隔毫秒（file host 不稳时 1s 衔接续传更快；仍受 TPS 1/s 约束）
PAWCHIVE_RETRY_INTERVAL_MS=1000
# 慢速退避：判定为慢速的速度阈值 KB/s
PAWCHIVE_SLOW_SPEED_KB=5
# 慢速持续判定窗口毫秒（连续低于阈值这么久才退避）
PAWCHIVE_SLOW_DETECT_MS=10000
# 慢速退避等待毫秒（窗口恢复后继续）
PAWCHIVE_SLOW_WAIT_MS=60000
# 慢速退避最大次数
PAWCHIVE_SLOW_MAX=3
# 是否下载正文里的网盘链接（0=关，其余=开；目前支持 Google Drive，provider 可扩展：mega/baidu 等）
PAWCHIVE_DOWNLOAD_DRIVE=1
# 反爬占位大小（file host bot 提示字节特征；默认 376）
PAWCHIVE_ANTIBOT_SIZE=376
# 404/错误页判定阈值（小于此大小才读头部判断；默认 4096）
PAWCHIVE_404_PAGE_MAX=4096
# curl 连接超时秒（下载与流式请求统一；默认 30）
PAWCHIVE_CURL_CONNECT_TIMEOUT=30
# 网页基址（原链接/创作者页 href；默认 https://pawchive.pw）
PAWCHIVE_WEB_BASE=https://pawchive.pw
# 强校验模式（0=关 默认；1=下载完计算本地 sha256 vs 目标 serverPath hash——不符优先修复（重下）不保留坏文件）
PAWCHIVE_STRICT_VERIFY=0
# 跨进程文件锁目录（同 serverPath 并发多 cli 防重复下载；默认 <数据根>/.pawchive/locks）
PAWCHIVE_LOCK_DIR=

# ---------- 其他 ----------
# curl 可执行文件路径（默认自动探测 /usr/bin/curl 等；Alpine/BusyBox/NAS 可显式指定）
# PAWCHIVE_CURL=/bin/curl
# 日志文件路径
# PAWCHIVE_LOG=./pawchive.log
# 默认输出根目录（cli 参数 path 优先；示例为通用路径，实际值写入 .env）
# PAWCHIVE_DATA_ROOT=~/Pawchive-downloads
# 附件子目录（默认空=帖根目录；空 / "." / "/" 三者等价=帖根不建子目录；设 attachments 等可配，附件落 <帖子目录>/attachments/）
# PAWCHIVE_ATTACHMENTS_SUBDIR=attachments
# 修订版本下载（默认开——作者编辑过的历史版本存 帖目录/<PAWCHIVE_REVISIONS_SUBDIR>/<revision_id>/；内容 sha256 硬链接去重不占额外空间；'0'=关）
PAWCHIVE_INCLUDE_REVISIONS=1
# 修订版本子目录名（默认 revisions——原版 post_structure.revisions 同源）
PAWCHIVE_REVISIONS_SUBDIR=revisions
# 外链文件（我们 html 内嵌——存在但不用：统一标记 FALSE，无值/有值都=关）
PAWCHIVE_EXTERNAL_LINKS=FALSE
# 创作者全量缓存 TTL（天，默认 7——搜索用 .pawchive/creators-cache.json）
PAWCHIVE_CREATORS_TTL_DAY=7
