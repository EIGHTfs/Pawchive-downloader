# 工具脚本：研究期一次性工具忽略；契约/API 提取工具（更新上游契约时复用）白名单入库
tools/*
!tools/extract-contract.cjs
!tools/extract-css.mjs
!tools/extract-ktool-apis.py

# 文档：自研 md 全部入库（审计/分析/结论/记录）；docs/.probe-ktoolbox 是上游 KToolBox 完整克隆（另仓库管理）不入库
docs/*
!docs/*.md

# 回收站 / 内部运行数据
.trash/
.pawchive/
*.log
*.pid
sessions.json

# 运行态配置（含口令哈希，不入库——用 --set-password 生成）
config.json

# 构建/依赖（本为零依赖项目，防御性忽略）
node_modules/
*.lock

# 本地备份（用户手工备份，不入库）
*.bak

# 实际运行配置（真实路径/口令，不入库；模板见 env.example）
.env
node_modules.orig/

# 前端错误上报日志（AI 读取定位用——运行产物不入库）
.client-errors.jsonl
# 兼容层运行产物（SQLite 数据库不入库）
webui.db
webui.db-wal
webui.db-shm
# 前端重建备份目录（webui-static/.bak-*/ 与 static.bak-*/——审计扫到不入库）
.bak-*/

# webui-static bundle 备份目录（同级 webui-static.bak-*——更新 bundle 的快照——不入库）
webui-static.bak-*/
